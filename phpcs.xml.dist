<?xml version="1.0"?>
<ruleset name="NB Menu démarrer WP">
	<description>WordPress coding standards for NB Menu démarrer WP.</description>

	<file>wp-start-menu.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
</ruleset>
